+# define php_SSLv3_client_method()  TLS_method()
+# define php_SSLv3_server_method()  TLS_server_method()
+#else
+# define php_SSLv23_client_method() SSLv23_client_method()
+# define php_SSLv23_server_method() SSLv23_server_method()
+# define php_SSLv2_client_method()  SSLv2_client_method()
+# define php_SSLv2_server_method()  SSLv2_server_method()
+# define php_SSLv3_client_method()  SSLv3_client_method()
+# define php_SSLv3_server_method()  SSLv3_server_method()
+#endif
+
 #ifdef PHP_WIN32
 #include "win32/time.h"
 #endif
