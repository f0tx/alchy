+/* OpenSSL 4.1 made ASN1_STRING opaque, dropped ASN1_STRING_data() and
+ * deprecated ASN1_STRING_length(); go through the accessors instead */
+#if OPENSSL_VERSION_NUMBER >= 0x40100000L
+# define php_ASN1_STRING_data(s)   ASN1_STRING_get0_data(s)
+# define php_ASN1_STRING_length(s) ((int)ASN1_STRING_get_length(s))
+#else
+# define php_ASN1_STRING_data(s)   ASN1_STRING_data(s)
+# define php_ASN1_STRING_length(s) ASN1_STRING_length(s)
+#endif
