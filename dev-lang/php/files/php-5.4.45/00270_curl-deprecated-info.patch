libcurl >= 7.55 deprecated the numeric CURLINFO_* ids (php-5.4)

CURLINFO_(TOTAL|NAMELOOKUP|CONNECT|PRETRANSFER|STARTTRANSFER|REDIRECT)_TIME,
CURLINFO_(SIZE|SPEED)_(UP|DOWN)LOAD, CURLINFO_CONTENT_LENGTH_(UP|DOWN)LOAD and
CURLINFO_FILETIME fill a long/double and are deprecated in favour of the
curl_off_t based *_T ids.

Map the PHP constant names onto the modern ids and collect the values into a
curl_off_t, so curl_getinfo() keeps returning double/long without
-Wdeprecated-declarations noise.  Guarded with LIBCURL_VERSION_NUM, older
libcurl still builds.

Patch against upstream php-5.4.45 sources.

--- a/ext/curl/interface.c
+++ b/ext/curl/interface.c
@@ -153,6 +153,39 @@
 
 #define SAVE_CURL_ERROR(__handle, __err) (__handle)->err.no = (int) __err;
 
+/* libcurl 7.55 deprecated the numeric CURLINFO_* ids that store the result in
+ * a long/double in favour of the curl_off_t based *_T ids.  Keep the PHP
+ * constant names -- they are part of the extension's API -- but point them at
+ * the modern ids, so building against libcurl >= 7.55 is warning free. */
+#if LIBCURL_VERSION_NUM >= 0x073700 /* 7.55.0 */
+# undef CURLINFO_FILETIME
+# undef CURLINFO_TOTAL_TIME
+# undef CURLINFO_NAMELOOKUP_TIME
+# undef CURLINFO_CONNECT_TIME
+# undef CURLINFO_PRETRANSFER_TIME
+# undef CURLINFO_SIZE_UPLOAD
+# undef CURLINFO_SIZE_DOWNLOAD
+# undef CURLINFO_SPEED_DOWNLOAD
+# undef CURLINFO_SPEED_UPLOAD
+# undef CURLINFO_CONTENT_LENGTH_DOWNLOAD
+# undef CURLINFO_CONTENT_LENGTH_UPLOAD
+# undef CURLINFO_STARTTRANSFER_TIME
+# undef CURLINFO_REDIRECT_TIME
+# define CURLINFO_FILETIME                 CURLINFO_FILETIME_T
+# define CURLINFO_TOTAL_TIME               CURLINFO_TOTAL_TIME_T
+# define CURLINFO_NAMELOOKUP_TIME          CURLINFO_NAMELOOKUP_TIME_T
+# define CURLINFO_CONNECT_TIME             CURLINFO_CONNECT_TIME_T
+# define CURLINFO_PRETRANSFER_TIME         CURLINFO_PRETRANSFER_TIME_T
+# define CURLINFO_SIZE_UPLOAD              CURLINFO_SIZE_UPLOAD_T
+# define CURLINFO_SIZE_DOWNLOAD            CURLINFO_SIZE_DOWNLOAD_T
+# define CURLINFO_SPEED_DOWNLOAD           CURLINFO_SPEED_DOWNLOAD_T
+# define CURLINFO_SPEED_UPLOAD             CURLINFO_SPEED_UPLOAD_T
+# define CURLINFO_CONTENT_LENGTH_DOWNLOAD  CURLINFO_CONTENT_LENGTH_DOWNLOAD_T
+# define CURLINFO_CONTENT_LENGTH_UPLOAD    CURLINFO_CONTENT_LENGTH_UPLOAD_T
+# define CURLINFO_STARTTRANSFER_TIME       CURLINFO_STARTTRANSFER_TIME_T
+# define CURLINFO_REDIRECT_TIME            CURLINFO_REDIRECT_TIME_T
+#endif
+
 #define CAAL(s, v) add_assoc_long_ex(return_value, s, sizeof(s), (long) v);
 #define CAAD(s, v) add_assoc_double_ex(return_value, s, sizeof(s), (double) v);
 #define CAAS(s, v) add_assoc_string_ex(return_value, s, sizeof(s), (char *) (v ? v : ""), 1);
